{
  "appId": "com.careerpath.app",
  "appName": "CareerPath",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https",
    "iosScheme": "https",
    "allowNavigation": [
      "*"
    ],
    "url": "https://career-path-five-ruby.vercel.app"
  },
  "android": {
    "buildOptions": {
      "keystorePath": "release-key.keystore",
      "keystoreAlias": "careerpath",
      "keystorePassword": "$KEYSTORE_PASSWORD",
      "keyPassword": "$KEY_PASSWORD"
    }
  }
}

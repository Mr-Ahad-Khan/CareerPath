{
  "appId": "com.careerpath.app",
  "appName": "CareerPath",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https",
    "iosScheme": "https",
    "allowNavigation": [
      "*"
    ]
  },
  "plugins": {
    "StatusBar": {
      "overlaysWebView": false,
      "style": "DARK",
      "backgroundColor": "#0e1014"
    }
  },
  "android": {
    "buildOptions": {
      "keystorePath": "release-key.keystore",
      "keystoreAlias": "careerpath",
      "keystorePassword": "$KEYSTORE_PASSWORD",
      "keyPassword": "$KEY_PASSWORD"
    }
  }
}
